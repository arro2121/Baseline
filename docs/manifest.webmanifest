{
 "id": "./",
 "name": "Cosmo Sports",
 "short_name": "Cosmo Sports",
 "lang": "en",
 "dir": "ltr",
 "description": "Every game, every league, one app. Live scores, animated play-by-play with real highlight replays, box scores, standings, team pages with schedules and rosters, news, and data-driven win predictions for the NFL, NBA, MLB, NHL, Premier League and tennis. Follow your teams across every league.",
 "categories": [
  "sports",
  "news",
  "entertainment"
 ],
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "display_override": [
  "standalone"
 ],
 "orientation": "any",
 "background_color": "#140F3A",
 "theme_color": "#140F3A",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icon-1024.png",
   "sizes": "1024x1024",
   "type": "image/png"
  },
  {
   "src": "favicon.svg",
   "sizes": "any",
   "type": "image/svg+xml"
  }
 ],
